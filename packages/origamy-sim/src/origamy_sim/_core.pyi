from collections.abc import Sequence

import numpy as np
from numpy.typing import ArrayLike, NDArray

class SingularError(RuntimeError): ...

class Mesh:
    def __init__(self, rest: ArrayLike, triangles: ArrayLike) -> None: ...
    @property
    def rest(self) -> NDArray[np.float64]: ...
    @property
    def triangles(self) -> NDArray[np.int64]: ...
    @property
    def edges(self) -> NDArray[np.int64]: ...
    @property
    def dihedrals(self) -> NDArray[np.int64]: ...
    @property
    def boundary(self) -> NDArray[np.int64]: ...
    @property
    def area(self) -> float: ...

class Stiffness:
    def __init__(
        self,
        *,
        along: float,
        across: float,
        poisson: float,
        shear: float,
        grain: float = 0.0,
    ) -> None: ...
    @staticmethod
    def isotropic(young: float, poisson: float) -> Stiffness: ...
    @property
    def along(self) -> float: ...
    @property
    def across(self) -> float: ...
    @property
    def poisson(self) -> float: ...
    @property
    def shear(self) -> float: ...
    @property
    def grain(self) -> float: ...

class Material:
    def __init__(
        self,
        *,
        thickness: float | None = None,
        mass_per_area: float | None = None,
        stiffness: Stiffness | None = None,
        strain_cap: float | None = None,
        strain_onset: float | None = None,
    ) -> None: ...
    @staticmethod
    def kami() -> Material: ...
    def replace(
        self,
        *,
        thickness: float | None = None,
        mass_per_area: float | None = None,
        stiffness: Stiffness | None = None,
        strain_cap: float | None = None,
        strain_onset: float | None = None,
    ) -> Material: ...
    @property
    def thickness(self) -> float: ...
    @property
    def mass_per_area(self) -> float: ...
    @property
    def stiffness(self) -> Stiffness: ...
    @property
    def strain_cap(self) -> float: ...
    @property
    def strain_onset(self) -> float: ...

class Crease:
    def __init__(self, *, stiffness: float, rest_angle: float) -> None: ...
    @property
    def stiffness(self) -> float: ...
    @property
    def rest_angle(self) -> float: ...

class Sheet:
    def __init__(self, mesh: Mesh, material: Material | None = None) -> None: ...
    @property
    def mesh(self) -> Mesh: ...
    @property
    def material(self) -> Material: ...
    @material.setter
    def material(self, material: Material) -> None: ...
    def crease(self, edge: tuple[int, int]) -> Crease | None: ...
    def set_crease(self, edge: tuple[int, int], crease: Crease | None) -> None: ...

class Settings:
    def __init__(
        self,
        *,
        gravity: tuple[float, float, float] | None = None,
        time_step: float | None = None,
        tolerance: float | None = None,
        iteration_limit: int | None = None,
        sufficient_decrease: float | None = None,
        shortest_update: float | None = None,
    ) -> None: ...
    def replace(
        self,
        *,
        gravity: tuple[float, float, float] | None = None,
        time_step: float | None = None,
        tolerance: float | None = None,
        iteration_limit: int | None = None,
        sufficient_decrease: float | None = None,
        shortest_update: float | None = None,
    ) -> Settings: ...
    @property
    def gravity(self) -> tuple[float, float, float]: ...
    @property
    def time_step(self) -> float: ...
    @property
    def tolerance(self) -> float: ...
    @property
    def iteration_limit(self) -> int: ...
    @property
    def sufficient_decrease(self) -> float: ...
    @property
    def shortest_update(self) -> float: ...

class Energy:
    @property
    def stretching(self) -> float: ...
    @property
    def strain_barrier(self) -> float: ...
    @property
    def bending(self) -> float: ...
    @property
    def creases(self) -> float: ...
    @property
    def gravity(self) -> float: ...
    @property
    def kinetic(self) -> float: ...

class Report:
    @property
    def converged(self) -> bool: ...
    @property
    def iterations(self) -> int: ...
    @property
    def update(self) -> float: ...
    @property
    def energy(self) -> Energy: ...
    @property
    def greatest_strain(self) -> float: ...
    @property
    def time(self) -> float: ...

class Simulation:
    def __init__(
        self, sheets: Sequence[Sheet], settings: Settings | None = None
    ) -> None: ...
    @property
    def settings(self) -> Settings: ...
    @settings.setter
    def settings(self, settings: Settings) -> None: ...
    @property
    def time(self) -> float: ...
    def sheet(self, sheet: int) -> Sheet: ...
    def set_material(self, sheet: int, material: Material) -> None: ...
    def set_crease(
        self, sheet: int, edge: tuple[int, int], crease: Crease | None
    ) -> None: ...
    def positions(self, sheet: int) -> NDArray[np.float64]: ...
    def set_positions(self, sheet: int, positions: ArrayLike) -> None: ...
    def velocities(self, sheet: int) -> NDArray[np.float64]: ...
    def set_velocities(self, sheet: int, velocities: ArrayLike) -> None: ...
    def held(self, sheet: int) -> NDArray[np.bool_]: ...
    def hold(self, sheet: int, vertex: int, *, held: bool = True) -> None: ...
    def fold_angles(self, sheet: int) -> NDArray[np.float64]: ...
    def energy(self) -> Energy: ...
    def step(self) -> Report: ...
