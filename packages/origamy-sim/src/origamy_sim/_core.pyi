from collections.abc import Sequence

import numpy as np
from numpy.typing import ArrayLike, NDArray

from origamy_sim.parameters import Body, Crease, Material, Refinement, Settings

class SingularError(RuntimeError): ...

class Mesh:
    def __init__(self, rest: ArrayLike, triangles: ArrayLike) -> None: ...
    @staticmethod
    def grid(columns: int, rows: int, width: float, height: float) -> Mesh: ...
    @staticmethod
    def of_faces(
        points: ArrayLike, faces: Sequence[Sequence[int]], refinement: Refinement
    ) -> tuple[Mesh, NDArray[np.int64]]: ...
    @property
    def rest(self) -> NDArray[np.float64]: ...
    @property
    def triangles(self) -> NDArray[np.int64]: ...
    @property
    def edges(self) -> NDArray[np.int64]: ...
    @property
    def dihedrals(self) -> NDArray[np.int64]: ...
    @property
    def boundary(self) -> NDArray[np.int64]: ...
    @property
    def area(self) -> float: ...

class Sheet:
    def __init__(self, mesh: Mesh, material: Material | None = None) -> None: ...
    @property
    def mesh(self) -> Mesh: ...
    @property
    def material(self) -> Material: ...
    @material.setter
    def material(self, material: Material) -> None: ...
    def crease(self, edge: tuple[int, int]) -> Crease | None: ...
    def set_crease(self, edge: tuple[int, int], crease: Crease | None) -> None: ...
    def rest_angle(self, edge: tuple[int, int]) -> float: ...
    def set_rest_angle(self, edge: tuple[int, int], angle: float) -> None: ...
    def plastic_rotation(self, edge: tuple[int, int]) -> float: ...

class Energy:
    @property
    def stretching(self) -> float: ...
    @property
    def strain_barrier(self) -> float: ...
    @property
    def bending(self) -> float: ...
    @property
    def creases(self) -> float: ...
    @property
    def yielding(self) -> float: ...
    @property
    def contact(self) -> float: ...
    @property
    def friction(self) -> float: ...
    @property
    def drag(self) -> float: ...
    @property
    def loads(self) -> float: ...
    @property
    def gravity(self) -> float: ...
    @property
    def kinetic(self) -> float: ...
    @property
    def total(self) -> float: ...

class Report:
    @property
    def converged(self) -> bool: ...
    @property
    def iterations(self) -> int: ...
    @property
    def substeps(self) -> int: ...
    @property
    def update(self) -> float: ...
    @property
    def energy(self) -> Energy: ...
    @property
    def greatest_strain(self) -> float: ...
    @property
    def contacts(self) -> int: ...
    @property
    def least_gap(self) -> float: ...
    @property
    def time(self) -> float: ...

class Simulation:
    def __init__(
        self, sheets: Sequence[Sheet], settings: Settings | None = None
    ) -> None: ...
    @property
    def settings(self) -> Settings: ...
    @settings.setter
    def settings(self, settings: Settings) -> None: ...
    @property
    def time(self) -> float: ...
    def sheet(self, sheet: int) -> Sheet: ...
    def set_material(self, sheet: int, material: Material) -> None: ...
    def set_crease(
        self, sheet: int, edge: tuple[int, int], crease: Crease | None
    ) -> None: ...
    def set_rest_angle(
        self, sheet: int, edge: tuple[int, int], angle: float
    ) -> None: ...
    def positions(self, sheet: int) -> NDArray[np.float64]: ...
    def set_positions(self, sheet: int, positions: ArrayLike) -> None: ...
    def velocities(self, sheet: int) -> NDArray[np.float64]: ...
    def set_velocities(self, sheet: int, velocities: ArrayLike) -> None: ...
    def held(self, sheet: int) -> NDArray[np.bool_]: ...
    def hold(self, sheet: int, vertices: ArrayLike, *, held: bool = True) -> None: ...
    def move_held(
        self, sheet: int, vertices: ArrayLike, positions: ArrayLike
    ) -> None: ...
    def hold_forces(self, sheet: int) -> NDArray[np.float64]: ...
    def forces(self, sheet: int) -> NDArray[np.float64]: ...
    def set_forces(
        self, sheet: int, vertices: ArrayLike, forces: ArrayLike
    ) -> None: ...
    def pressure(self, sheet: int) -> float: ...
    def set_pressure(self, sheet: int, pressure: float) -> None: ...
    def add_body(self, body: Body, points: ArrayLike) -> int: ...
    @property
    def bodies(self) -> list[Body]: ...
    def body_points(self, body: int) -> NDArray[np.float64]: ...
    def move_body(self, body: int, points: ArrayLike) -> None: ...
    def body_force(self, body: int) -> NDArray[np.float64]: ...
    def grip(self, body: int, sheet: int, vertices: ArrayLike) -> None: ...
    def release(self, body: int) -> None: ...
    def grips(self, sheet: int) -> NDArray[np.int64]: ...
    def fold_angles(self, sheet: int) -> NDArray[np.float64]: ...
    def energy(self) -> Energy: ...
    def step(self) -> Report: ...
